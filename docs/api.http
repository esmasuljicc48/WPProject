@base = http://localhost:8000/backend
@json = application/json

### Expected status table
# GET    collection/resource/relationship: 200 success, 404 when the resource does not exist
# POST   valid resource: 201, invalid input or duplicate relationship: 400
# PUT    valid resource: 200, invalid input: 400, missing resource: 404
# DELETE valid resource: 200, invalid relationship: 404, protected category: 400
# Weather success: 200, invalid query: 400, unknown city: 404, provider failure: 503
# Unknown route: 404

### API health
GET {{base}}/

### Categories
GET {{base}}/categories
GET {{base}}/categories/1
GET {{base}}/categories/999999

POST {{base}}/categories
Content-Type: {{json}}

{
  "name": "Weaving",
  "description": "Handwoven textile projects."
}

PUT {{base}}/categories/1
Content-Type: {{json}}

{
  "name": "Knitting",
  "description": "Projects made with knitting needles."
}

DELETE {{base}}/categories/999999

